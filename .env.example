# StudyBridge backend environment variables

# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (Railway MySQL)
# Prefer using DATABASE_URL; fallback vars are for local development.
# On Railway, you can map DATABASE_URL to the provided MYSQL_URL.
DATABASE_URL=
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=railway

# Auth
JWT_SECRET=change-me-in-production

# LLM / OpenAI
OPENAI_API_KEY=
